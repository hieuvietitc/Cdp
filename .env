# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=cdp
POSTGRES_PASSWORD=cdppassword
POSTGRES_DB=cdpdb

# ─── External DB connections (loyalty & sales systems) ────────────────────
LOYALTY_DB_URL=postgresql://user:pass@loyalty-host:5432/loyalty_db
SALES_DB_URL=postgresql://user:pass@sales-host:5432/sales_db

# ─── Security ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# ─── Email: SendGrid ──────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMS: eSMS (Vietnam) ──────────────────────────────────────────────────
ESMS_API_KEY=your_esms_api_key
ESMS_SECRET_KEY=your_esms_secret_key
ESMS_BRAND_NAME=YourBrand

# ─── Ads: Meta ────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=your_meta_access_token
META_AD_ACCOUNT_ID=act_123456789

# ─── Ads: Google ──────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ─── Monitoring: Grafana ──────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-in-production

# ─── Analytics: Superset ──────────────────────────────────────────────────
SUPERSET_SECRET_KEY=change-this-to-a-long-random-string-in-production
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-this-in-production
SUPERSET_ADMIN_EMAIL=admin@yourdomain.com

# ─── Backup ───────────────────────────────────────────────────────────────
BACKUP_RETAIN_DAYS=14

# ─── Scaling (optional overrides) ────────────────────────────────────────
PROCESSOR_CONCURRENCY=8
STREAM_BATCH_SIZE=100
STREAM_LAG_WARN=10000
